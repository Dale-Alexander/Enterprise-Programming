
@model Common.Models.Reservation

@{
    ViewData["Title"] = "Self Borrow";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        <i class="bi bi-book-half"></i> Borrow a Book
                    </h4>
                </div>

                <div class="card-body p-4">

                    <p class="text-muted mb-4">
                        Enter the Book ID of the book you wish to borrow.
                    </p>

                    <form asp-action="SelfBorrow" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">
                            <label asp-for="BookFK" class="form-label fw-semibold">
                                Book ID
                            </label>

                            <input asp-for="BookFK"
                                   class="form-control form-control-lg"
                                   placeholder="Enter Book ID"
                                   required />

                            <span asp-validation-for="BookFK"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i>
                                Borrow Book
                            </button>
                        </div>

                    </form>

                </div>

                <div class="card-footer bg-light text-center text-muted">
                    <small>Make sure you enter a valid Book ID.</small>
                </div>
            </div>

        </div>
    </div>
</div>
